/* ---------- tokens ---------- */
:root{
  --bg: #14161A;
  --panel: #1D2027;
  --panel-2: #23262E;
  --line: #33363F;
  --text: #F4F1EA;
  --text-muted: #9A9DA6;
  --amber: #E8A33D;
  --amber-dim: #7A5A28;
  --red: #D6584F;
  --radius-sm: 6px;
  --radius-md: 10px;
  --font-display: 'Space Grotesk', sans-serif;
  --font-body: 'Inter', sans-serif;
}

*{ box-sizing: border-box; }
html{ scroll-behavior: smooth; }
body{
  margin:0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
ul,ol{ margin:0; padding:0; list-style:none; }
h1,h2,h3{ font-family: var(--font-display); margin:0; font-weight:600; letter-spacing:-0.01em; }
p{ margin:0; }

.wrap{ max-width:1180px; margin:0 auto; padding:0 28px; }

:focus-visible{ outline: 2px solid var(--amber); outline-offset: 3px; }

@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior:auto; }
  *{ animation-duration:0.001ms !important; transition-duration:0.001ms !important; }
}

/* ---------- buttons & fields ---------- */
.btn{
  display:inline-flex; align-items:center; justify-content:center;
  padding: 13px 22px; border-radius: var(--radius-sm);
  font-family: var(--font-body); font-weight:600; font-size:0.95rem;
  border:1px solid transparent; cursor:pointer; transition: transform .15s ease, background .15s ease;
}
.btn-primary{ background: var(--amber); color:#1B1300; }
.btn-primary:hover{ background:#f0b256; transform: translateY(-1px); }
.btn-block{ width:100%; }

.field{ display:flex; flex-direction:column; gap:6px; font-size:0.88rem; color: var(--text-muted); }
.field span{ font-weight:500; }
.field input, .field select{
  font-family: var(--font-body); font-size: 0.95rem; color: var(--text);
  background: var(--panel-2); border:1px solid var(--line); border-radius: var(--radius-sm);
  padding: 11px 12px;
}
.field input:focus, .field select:focus{ border-color: var(--amber); }
.field-row{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.field-error{ color: var(--red); font-size:0.82rem; margin-top:-6px; }

.section-title{ font-size: clamp(1.6rem, 2.6vw, 2.2rem); max-width: 640px; }

/* ---------- header ---------- */
.site-header{
  position: sticky; top:0; z-index:40;
  background: rgba(20,22,26,0.9); backdrop-filter: blur(10px);
  border-bottom:1px solid var(--line);
}
.header-inner{ display:flex; align-items:center; gap:28px; padding-top:14px; padding-bottom:14px; }
.logo{ display:flex; align-items:center; gap:9px; font-family: var(--font-display); font-weight:600; font-size:1.15rem; margin-right:auto; }
.main-nav{ display:flex; gap:26px; font-size:0.92rem; color: var(--text-muted); }
.main-nav a:hover{ color: var(--text); }
.nav-toggle{ display:none; flex-direction:column; gap:4px; background:none; border:none; cursor:pointer; padding:8px; }
.nav-toggle span{ width:20px; height:2px; background: var(--text); }

/* ---------- hero ---------- */
.hero{ position:relative; overflow:hidden; padding: 76px 0 84px; border-bottom:1px solid var(--line); }
.hero-lines{ position:absolute; inset:0; opacity:0.35; pointer-events:none; overflow:hidden; }
.hero-lines svg{ width:110%; height:100%; }
.hero-lines line{ stroke: var(--amber-dim); stroke-width:1; }
.road-line{ animation: roadScroll 7s linear infinite; }
.road-line:nth-child(2){ animation-duration: 9s; }
.road-line:nth-child(3){ animation-duration: 6s; }
.road-line:nth-child(4){ animation-duration: 8s; }
@keyframes roadScroll{
  from{ transform: translateX(0); }
  to{ transform: translateX(-60px); }
}

.hero-car{
  position:absolute; left:-240px; bottom:64px; width:220px; pointer-events:none;
  animation: driveIn 1.6s cubic-bezier(.2,.8,.3,1) 0.3s forwards;
}
@keyframes driveIn{ to{ left: 6%; } }
.hero-wheel{ transform-origin:center; transform-box: fill-box; animation: spin 1.1s linear infinite; }
.hero-headlight{ animation: glow 2.4s ease-in-out infinite; }
@keyframes spin{ to{ transform: rotate(360deg); } }
@keyframes glow{
  0%,100%{ opacity:0.7; }
  50%{ opacity:1; filter: drop-shadow(0 0 4px #E8A33D); }
}
@media (max-width: 900px){ .hero-car{ display:none; } }

.hero-inner{ position:relative; display:grid; grid-template-columns: 1.15fr 0.85fr; gap:56px; align-items:start; }
.eyebrow{ color: var(--amber); font-size:0.85rem; font-weight:500; margin-bottom:16px; }
.hero h1{ font-size: clamp(2.1rem, 4.4vw, 3.4rem); line-height:1.08; margin-bottom:20px; }
.hero-sub{ color: var(--text-muted); max-width: 480px; font-size:1.03rem; margin-bottom:32px; }
.hero-stats{ display:flex; gap:34px; }
.hero-stats div{ display:flex; flex-direction:column; }
.hero-stats strong{ font-family: var(--font-display); font-size:1.3rem; }
.hero-stats span{ color: var(--text-muted); font-size:0.82rem; }

.booking-card{
  background: var(--panel); border:1px solid var(--line); border-radius: var(--radius-md);
  padding:26px; display:flex; flex-direction:column; gap:16px;
}
.booking-card h2{ font-size:1.15rem; margin-bottom:2px; }

/* ---------- how it works ---------- */
.how{ padding: 84px 0; border-bottom:1px solid var(--line); }
.steps{ display:grid; grid-template-columns: repeat(3,1fr); gap:32px; margin-top:44px; }
.step-num{ font-family: var(--font-display); color: var(--amber); font-size:1.6rem; display:block; margin-bottom:14px; }
.steps h3{ font-size:1.15rem; margin-bottom:8px; }
.steps p{ color: var(--text-muted); font-size:0.95rem; }

/* ---------- fleet ---------- */
.fleet{ padding: 84px 0; border-bottom:1px solid var(--line); background: var(--panel); }
.section-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:24px; flex-wrap:wrap; margin-bottom:40px; }
.section-head p{ color: var(--text-muted); max-width:320px; }
.fleet-grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; }
.car-card{ background: var(--panel-2); border:1px solid var(--line); border-radius: var(--radius-md); padding:22px; display:flex; flex-direction:column; gap:12px; }
.car-visual{ height:88px; display:flex; align-items:center; justify-content:center; }
.car-visual svg{ width:100%; height:100%; }
.car-name{ font-family: var(--font-display); font-size:1.08rem; }
.car-meta{ display:flex; gap:12px; color: var(--text-muted); font-size:0.82rem; }
.car-foot{ display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:8px; border-top:1px solid var(--line); }
.car-price strong{ font-family: var(--font-display); color: var(--amber); font-size:1.1rem; }
.car-price span{ color: var(--text-muted); font-size:0.78rem; }
.car-select{ background:none; border:1px solid var(--line); color: var(--text); padding:8px 14px; border-radius: var(--radius-sm); cursor:pointer; font-size:0.85rem; }
.car-select:hover{ border-color: var(--amber); color: var(--amber); }

.car-illustration{ width:100%; height:100%; }
.wheel-group{ transform-origin:center; transform-box: fill-box; transition: transform 4s linear; }
.car-card:hover .wheel-group{ animation: spin 0.8s linear infinite; }
.headlight{ transition: filter .3s ease, opacity .3s ease; }
.car-card:hover .headlight{ filter: drop-shadow(0 0 3px currentColor); }

/* ---------- brands ---------- */
.brands{ padding: 54px 0 60px; border-bottom:1px solid var(--line); }
.brands-label{ color: var(--text-muted); font-size:0.88rem; margin-bottom:26px; }
.brand-marquee{ overflow:hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
.brand-track{ display:flex; gap:52px; width:max-content; animation: marquee 26s linear infinite; }
.brand-track span{ font-family: var(--font-display); font-size:1.3rem; color: var(--text-muted); white-space:nowrap; }
@keyframes marquee{ from{ transform: translateX(0); } to{ transform: translateX(-50%); } }

/* ---------- part-by-part inspection ---------- */
.parts{ padding: 84px 0; border-bottom:1px solid var(--line); background: var(--panel); }
.parts-grid{ display:grid; grid-template-columns: repeat(4,1fr); gap:20px; }
.part-card{ background: var(--panel-2); border:1px solid var(--line); border-radius: var(--radius-md); padding:22px; transition: transform .2s ease, border-color .2s ease; }
.part-card:hover{ transform: translateY(-4px); border-color: var(--amber); }
.part-icon{ width:40px; height:40px; margin-bottom:14px; transition: transform .3s ease; }
.part-card:hover .part-icon{ transform: scale(1.12) rotate(-4deg); }
.part-card h3{ font-size:1rem; margin-bottom:6px; }
.part-card p{ color: var(--text-muted); font-size:0.88rem; }

/* ---------- why ---------- */
.why{ padding: 88px 0; border-bottom:1px solid var(--line); }
.why-grid{ display:grid; grid-template-columns: 0.8fr 1.2fr; gap:56px; }
.why-lead p{ color: var(--text-muted); margin-top:16px; max-width:340px; }
.why-list{ display:grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; }
.why-list h3{ font-size:1.05rem; margin-bottom:6px; }
.why-list p{ color: var(--text-muted); font-size:0.92rem; }

/* ---------- pricing / estimator ---------- */
.pricing{ padding: 88px 0; border-bottom:1px solid var(--line); background: var(--panel); }
.pricing-inner{ display:grid; grid-template-columns: 0.9fr 1.1fr; gap:56px; align-items:center; }
.pricing-copy p{ color: var(--text-muted); margin-top:16px; max-width:360px; }
.pricing-card{ background: var(--panel-2); border:1px solid var(--line); border-radius: var(--radius-md); padding:26px; display:flex; flex-direction:column; gap:16px; }
.estimate-out{ display:flex; justify-content:space-between; align-items:center; padding-top:14px; border-top:1px dashed var(--line); }
.estimate-out span{ color: var(--text-muted); font-size:0.9rem; }
.estimate-out strong{ font-family: var(--font-display); font-size:1.6rem; color: var(--amber); }
.estimate-note{ color: var(--text-muted); font-size:0.8rem; margin-top:-8px; }

/* ---------- testimonial ---------- */
.testimonial{ padding:90px 0; border-bottom:1px solid var(--line); }
.testimonial blockquote{ margin:0; font-family: var(--font-display); font-size: clamp(1.3rem,2.4vw,1.9rem); line-height:1.35; max-width:820px; }
.testimonial cite{ display:block; margin-top:22px; font-family: var(--font-body); font-style:normal; color: var(--amber); font-size:0.95rem; }

/* ---------- locations ---------- */
.locations{ padding: 84px 0; border-bottom:1px solid var(--line); background: var(--panel); }
.locations-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:16px; margin-top:36px; }
.locations-grid div{ display:flex; align-items:center; gap:10px; padding:14px 16px; background: var(--panel-2); border:1px solid var(--line); border-radius: var(--radius-sm); font-size:0.92rem; }

/* ---------- book / contact ---------- */
.book{ padding: 92px 0; }
.book-inner{ display:grid; grid-template-columns: 0.9fr 1.1fr; gap:56px; align-items:start; }
.book-inner p{ color: var(--text-muted); margin-top:16px; max-width:360px; }
.contact-card{ background: var(--panel); border:1px solid var(--line); border-radius: var(--radius-md); padding:26px; display:flex; flex-direction:column; gap:16px; }

/* ---------- footer ---------- */
.site-footer{ border-top:1px solid var(--line); padding-top:56px; }
.footer-inner{ display:grid; grid-template-columns: 1fr 2fr; gap:40px; padding-bottom:40px; }
.logo-text{ font-family: var(--font-display); font-size:1.2rem; font-weight:600; }
.footer-brand p{ color: var(--text-muted); margin-top:10px; font-size:0.9rem; }
.footer-cols{ display:grid; grid-template-columns: repeat(3,1fr); gap:24px; }
.footer-cols h4{ font-size:0.85rem; color: var(--text-muted); margin-bottom:12px; font-weight:600; }
.footer-cols a{ display:block; font-size:0.9rem; padding:5px 0; color: var(--text); }
.footer-cols a:hover{ color: var(--amber); }
.footer-bottom{ border-top:1px solid var(--line); padding:20px 28px; color: var(--text-muted); font-size:0.82rem; }

/* ---------- modal ---------- */
.modal{ position:fixed; inset:0; background: rgba(10,11,13,0.7); display:none; align-items:center; justify-content:center; z-index:80; padding:20px; }
.modal.open{ display:flex; }
.modal-card{ background: var(--panel); border:1px solid var(--line); border-radius: var(--radius-md); padding:32px; max-width:420px; width:100%; position:relative; }
.modal-close{ position:absolute; top:14px; right:16px; background:none; border:none; color: var(--text-muted); font-size:1.4rem; cursor:pointer; }
.modal-card h3{ font-size:1.2rem; margin-bottom:10px; }
.modal-card p{ color: var(--text-muted); font-size:0.92rem; }

/* ---------- responsive ---------- */
@media (max-width: 900px){
  .hero-inner{ grid-template-columns: 1fr; }
  .steps{ grid-template-columns: 1fr; }
  .fleet-grid{ grid-template-columns: repeat(2,1fr); }
  .parts-grid{ grid-template-columns: repeat(2,1fr); }
  .why-grid{ grid-template-columns: 1fr; }
  .why-list{ grid-template-columns: 1fr; }
  .pricing-inner{ grid-template-columns: 1fr; }
  .locations-grid{ grid-template-columns: repeat(2,1fr); }
  .book-inner{ grid-template-columns: 1fr; }
  .footer-inner{ grid-template-columns: 1fr; }
  .footer-cols{ grid-template-columns: repeat(3,1fr); }
}
@media (max-width: 640px){
  .main-nav{
    position:absolute; top:100%; left:0; right:0; background: var(--bg);
    flex-direction:column; padding:18px 28px; border-bottom:1px solid var(--line);
    display:none; gap:4px;
  }
  .main-nav.open{ display:flex; }
  .main-nav a{ padding:10px 0; }
  .nav-toggle{ display:flex; }
  .nav-cta{ display:none; }
  .field-row{ grid-template-columns:1fr; }
  .fleet-grid{ grid-template-columns:1fr; }
  .parts-grid{ grid-template-columns:1fr; }
  .locations-grid{ grid-template-columns:1fr; }
  .footer-cols{ grid-template-columns:1fr; gap:18px; }
}
